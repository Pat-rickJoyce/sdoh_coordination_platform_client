<div class="table-responsive small-text">
    <table class="table table-sm text-center fw-semibold caption-top">
        <h3 class="text-secondary"><%= type.capitalize %> Tasks</h3>
        <thead>
          <tr>
            <th scope="col">Task</th>
            <th scope="col">Priority</th>
            <th scope="col">Status</th>
            <th scope="col">Category</th>
            <th scope="col">Owner</th>
            <th scope="col">Patient</th>
            <th scope="col">Consent</th>
            <th scope="col">Attachments</th>
            <% if type == "completed" %>
              <th scope="col">Outcomes</th>
            <% end %>
            <% if type == "cancelled" || type == "rejected" %>
              <th scope="col">Reason</th>
            <% end %>
            <% if type == "active" %>
              <th scope="col">Actions</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% referrals&.each do |referral| %>
            <tr id="task-row-<%= referral.id %>">
              <td>
                <%= referral.focus&.description.presence || "Referral" %>
                <%# A referral for further assessment is distinguished only by %>
                <%# ServiceRequest.code being an assessment procedure (rffa.html). %>
                <% if assessment_referral?(referral.focus) %>
                  <span class="badge bg-warning text-dark"
                        title="Referral for further assessment: the requested procedure is an assessment">Assessment</span>
                <% end %>
              </td>
              <td><%= referral.focus&.priority || "-" %></td>
              <td>
                <% status = referral.status %>

                <% if status == "requested" %>
                  <span class="badge rounded-pill bg-info text-dark"></span> Requested
                <% end %>
                <% if status == "in-progress" %>
                  <span class="bi bi-arrow-repeat text-success"></span> In Progress
                <% end %>
                <% if status == "completed" %>
                  <span class="bi bi-check-lg text-success"></span> Completed
                <% end %>
                <% if status == "received" %>
                  <span class="bi bi-arrow-bar-down text-primary"></span> Received
                <% end %>
                <% if status == "cancelled" || status == "rejected" %>
                  <span class="bi bi-x-circle text-danger"></span><%= status %>
                <% end %>

                <% if status == "accepted" %>
                  <span class="bi bi-check-circle text-success"></span> Accepted
                <% end %>
              </td>
              <td><%= referral.focus&.category || "-" %></td>
              <td><%= referral.owner_name %></td>
              <td><%= referral.patient_name %></td>
              <td>
                <% if referral.consent.present? %>
                  <%= link_to referral.consent.code, "#fhir-resource-modal-#{referral.consent&.id}", data: { bs_toggle: "modal" } %>
                  <% content_for :modals do %>
                    <%= render "shared/fhir_resource_modal", resource: referral.consent.fhir_resource %>
                  <% end %>
                <% else %>
                --
                <% end %>
              </td>
              <td>
                <%= render "dashboard/task_attachments", referral: referral %>
                <% content_for :modals do %>
                  <%= render "dashboard/referral_detail", referral: referral %>
                <% end %>
              </td>
              <td>
                <% if type == "completed" %>
                  <%# The enrollment status the CBO closed the referral with
                      leads the cell; enrollment.html makes the coordination
                      platform the Intermediary that passes it on, and one badge
                      is worth reading at a glance. Everything else came back
                      through Task.output, and that is a drawer, not a list. %>
                  <% enrollment = referral.enrollment_status %>
                  <% if enrollment.present? %>
                    <div>
                      <%= link_to "#fhir-resource-modal-#{enrollment.id}", data: { bs_toggle: "modal" }, class: "text-decoration-none" do %>
                        <span class="badge <%= enrollment_status_badge_class(enrollment.enrollment_status_code) %>">
                          <%= enrollment.enrollment_status_display %>
                        </span>
                      <% end %>
                    </div>
                    <% content_for :modals do %>
                      <%= render "shared/fhir_resource_modal", resource: enrollment.fhir_resource %>
                    <% end %>
                  <% end %>
                  <% if referral.outputs.present? %>
                    <%= link_to "Review outcome", "#outcome-detail-#{referral.id}",
                          class: "small-text fw-semibold",
                          data: { bs_toggle: "offcanvas" } %>
                    <% content_for :modals do %>
                      <%= render "dashboard/outcome_detail", referral: referral %>
                    <% end %>
                  <% elsif enrollment.blank? %>
                    <span class="small-text text-secondary">Nothing returned</span>
                  <% end %>
                <% elsif type == "active" %>
                  <%= link_to "/tasks/#{referral.id}/cancelled", class: "action-button text-nowrap text-muted" do %>
                    <span class="icon"><i class="bi bi-trash text-muted"></i></span>
                    <span class="label">Cancel Task</span>
                  <% end %>
                <% elsif status == "rejected" || status == "cancelled" %>
                  <%= referral.status_reason || "--" %>
                <% end %>
              </td>
          </tr>
        <% end %>
      </tbody>
    </table>
</div>
